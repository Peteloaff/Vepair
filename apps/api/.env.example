# Copy to .env and fill in real values. Never commit .env.

# --- Database ---
DATABASE_URL=postgresql+psycopg://vepair:vepair@127.0.0.1:5432/vepair

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
API_CORS_ORIGINS=http://localhost:3000

# --- Supabase (auth) — added when Stage 1 wires up accounts ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Auth (self-hosted, Stage 1) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me-to-a-random-value

# --- Object storage ---
# Local filesystem in dev; leave as-is unless testing a cloud backend.
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./var/recordings
