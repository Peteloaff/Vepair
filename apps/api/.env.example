# Copy to .env and fill in real values. Never commit .env.

# --- Database ---
DATABASE_URL=postgresql+psycopg://vepair:vepair@127.0.0.1:5432/vepair

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
API_CORS_ORIGINS=http://localhost:3000

# --- Supabase ---
# SUPABASE_URL/SERVICE_ROLE_KEY are required when STORAGE_BACKEND=supabase (below). Auth
# itself is still self-hosted JWT (Stage 1) — these aren't used for auth yet.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Auth (self-hosted, Stage 1) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me-to-a-random-value

# --- Object storage ---
# "local" writes to STORAGE_LOCAL_PATH — fine for local dev, but NOT durable on a platform
# that wipes the container's disk on restart (e.g. Cloud Run). "supabase" uses a private
# Supabase Storage bucket instead (needs SUPABASE_URL/SUPABASE_SERVICE_ROLE_KEY above, and
# STORAGE_BUCKET to already exist as a private bucket).
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./var/recordings
STORAGE_BUCKET=recordings
